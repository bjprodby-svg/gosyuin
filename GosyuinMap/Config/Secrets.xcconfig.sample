// Secrets.xcconfig.sample
//
// First-time setup:
//   1. Copy this file to `Secrets.xcconfig` (same directory).
//   2. Paste your actual Google Cloud "Places API (New)" key.
//   3. `Secrets.xcconfig` is gitignored; never commit it.
//
// The value is substituted into Info.plist as $(GOOGLE_PLACES_API_KEY)
// and read at runtime by GooglePlacesService.

GOOGLE_PLACES_API_KEY =
